# Copy to .env (gitignored) and adjust. Loaded by scripts/common.sh when present.
# Override the path with VOICE_DEMO_ENV_FILE=/path/to/file

# VOICE_DEMO_ROOT is computed from script location; do not hardcode personal paths.

# Python interpreters (defaults: project .venv-*/bin/python)
# VOICE_DEMO_TOOLS_PYTHON=
# VOICE_DEMO_BACKEND_PYTHON=
# VOICE_DEMO_MOSHI_PYTHON=

# Upstreams
# VOICE_DEMO_UPSTREAM_DIR=
# HF_S2S_REPO=

# Model / cache homes (defaults under $VOICE_DEMO_ROOT/models and .cache)
# VOICE_DEMO_HF_HOME=
# HF_HOME=
# VOICE_DEMO_TORCH_HOME=
# TORCH_HOME=
# VOICE_DEMO_NLTK_DATA=
# NLTK_DATA=
# UV_CACHE_DIR=

# Modular listen address
# VOICE_DEMO_MODULAR_HOST=0.0.0.0
# VOICE_DEMO_MODULAR_PORT=8765

# Moshi official server + adapter
# MOSHI_HOST=127.0.0.1
# MOSHI_PORT=8998
# VOICE_DEMO_MOSHI_ADAPTER_HOST=127.0.0.1
# VOICE_DEMO_MOSHI_ADAPTER_PORT=9005
# VOICE_DEMO_MOSHI_SNAPSHOT=

# UI
# VOICE_DEMO_UI_HOST=127.0.0.1
# VOICE_DEMO_UI_PORT=7860
# VOICE_DEMO_MODULAR_URL=
# VOICE_DEMO_MOSHI_URL=
# VOICE_DEMO_NEMOTRON_URL=

# Optional Nemotron (prepare explicitly; NGC access + license required)
# NEMOTRON_MODEL_DIR=
# VOICE_DEMO_NEMOTRON_IMAGE=
# VOICE_DEMO_CONTAINER_RUNTIME=singularity
# VOICE_DEMO_CONTAINER_CACHE=
# VOICE_DEMO_NEMOTRON_HTTP=http://127.0.0.1:9000

# Browser tests
# PLAYWRIGHT_BROWSERS_PATH=
# VOICE_DEMO_BROWSER_LD_LIBRARY_PATH=

# Slurm submit helper (operator-supplied; not a baked cluster policy)
# VOICE_DEMO_SLURM_PARTITION=
# VOICE_DEMO_SLURM_QOS=
# VOICE_DEMO_SUBMIT_LOCK=

# Resident model supervisor (local control is off by default)
# VOICE_DEMO_INITIAL_MODEL=moshi
# VOICE_DEMO_SLOT_DIRECTORY=runtime/end-to-end
# VOICE_DEMO_SLOT_CONTROL=0
# VOICE_DEMO_STARTUP_WAV=artifacts/input/browser.wav
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
